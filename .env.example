# ===============================
# Template environment variables
# Copy file ini menjadi .env.local lalu isi nilainya
# ===============================

# Firebase (Client SDK — publik, aman untuk NEXT_PUBLIC_)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Sheets API (Server-side — Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Diisi otomatis oleh /api/setup-sheet setelah spreadsheet terhubung
GOOGLE_SHEETS_SPREADSHEET_ID=

# Admin allowlist (dipakai verifikasi API routes)
ADMIN_EMAIL=

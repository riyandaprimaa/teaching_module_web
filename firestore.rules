rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya admin (1 guru) yang boleh membaca/menulis.
    // Aplikasi juga memverifikasi token di setiap API route (lib/api-auth.ts).
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'riyandaprima69@gmail.com';
    }
  }
}
